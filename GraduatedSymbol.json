{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 650,
  "title": "Dubai Accident Distribution by Location",
  "data": {
    "url": "https://raw.githubusercontent.com/sheriefAbdallah/CS318/refs/heads/main/Traffic_Incidents.csv"
  },
  "transform": [
    {"filter": "datum.acci_y > 23"},
    {"bin": {"maxbins": 140}, "field": "acci_x", "as": "bin_latitude"},
    {"bin": {"maxbins": 140}, "field": "acci_y", "as": "bin_longitude"},
    {
      "aggregate": [{"op": "count", "as": "density"}],
      "groupby": ["bin_latitude", "bin_longitude"]
    }
  ],
  "projection": {"type": "mercator"},
  "mark": {"type": "circle", "opacity": 0.2},
  "encoding": {
    "longitude": {"field": "bin_longitude", "type": "quantitative"},
    "latitude": {"field": "bin_latitude", "type": "quantitative"},
    "size": {
      "field": "density",
      "type": "quantitative",
      "scale": {"range": [30, 1000]}
    },
    "color": {
      "field": "density",
      "type": "quantitative",
      "scale": {"scheme": "reds"}
    },
    "tooltip": [
      {"field": "density", "title": "Accidents Reported"},
      {"field": "bin_latitude", "title": "Latitude"},
      {"field": "bin_longitude", "title": "Longitude"}
    ]
  },
  "config": {}
}